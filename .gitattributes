###############################################################################
# Normalize line endings.
###############################################################################

* text=auto

###############################################################################
# Windows Driver source files.
###############################################################################

*.c       text eol=crlf
*.cpp     text eol=crlf
*.h       text eol=crlf
*.hpp     text eol=crlf
*.inl     text eol=crlf

*.idl     text eol=crlf
*.rc      text eol=crlf
*.def     text eol=crlf

*.sln     text eol=crlf
*.vcxproj text eol=crlf
*.filters text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf

###############################################################################
# INF files are UTF-16LE with BOM.
###############################################################################

*.inf text diff working-tree-encoding=UTF-16LE-BOM eol=crlf
*.inx text diff working-tree-encoding=UTF-16LE-BOM eol=crlf